# ── skills hub index cache (48MB, regenerated) ────────────────────────
skills/.hub/

# ── local-only escape hatch (never overwritten by `profile update`) ───
local/
distribution.yaml.lock

# ── misc ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store

# ── explicit allow — MUST stay last (git: last matching rule wins) ────
!.env.template
